# WAYTER Engineering System — configuração mecânica do projeto
# Lido por .agents/bin/validate.sh e .agents/hooks/guard-destructive.mjs.
# Este arquivo pertence ao projeto: `wayter update` NÃO o sobrescreve.
# Valores gerados por `wayter init` são detecção automática; confirme-os com a skill adopt-project.

# Gerenciador de pacotes: npm | pnpm | yarn | bun
WAYTER_PKG_MANAGER={{PKG_MANAGER}}

# Comandos executados pelo validate.sh (vazio = passo pulado com aviso "não configurado")
WAYTER_LINT="{{LINT}}"
WAYTER_TYPECHECK="{{TYPECHECK}}"
WAYTER_TEST="{{TEST}}"
WAYTER_BUILD="{{BUILD}}"
# 1 para rodar build no validate; 0 em projetos onde o build local é lento ou não faz sentido
WAYTER_BUILD_ENABLED={{BUILD_ENABLED}}

# Comando para rodar UM arquivo de teste (use {file} como placeholder). Usado por developer/tester.
WAYTER_TEST_FILE="{{TEST_FILE}}"

# Checagens extras, separadas por ';' no formato nome=comando
# Ex.: WAYTER_EXTRA_CHECKS="prisma=npx prisma validate;i18n=pnpm i18n:check"
WAYTER_EXTRA_CHECKS=""

# Timeout por passo do validate, em segundos
WAYTER_VALIDATE_TIMEOUT=1800

# Permissões git (ver .agents/git.md). 0 = bloqueado pelo hook mesmo que o agente tente.
WAYTER_ALLOW_PUSH=0
WAYTER_ALLOW_BRANCH=0

# Padrões extras bloqueados pelo guard (regex JS, separados por ';')
# Ex.: WAYTER_GUARD_EXTRA="pnpm db:seed:prod;scripts/danger"
WAYTER_GUARD_EXTRA=""
# 1 desliga o hook de guarda (decisão do usuário)
WAYTER_GUARD_DISABLE=0
