#!/usr/bin/env bash
set -e
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  TARGET="$(readlink "$SELF")"
  case "$TARGET" in
    /*) SELF="$TARGET" ;;
    *) SELF="$(cd "$(dirname "$SELF")" && pwd)/$TARGET" ;;
  esac
done
DIR="$(cd "$(dirname "$SELF")" && pwd)"
NODE="$(bash "$DIR/../core/bin/find-node.sh" 18)" || exit 1
exec "$NODE" "$DIR/wayter.mjs" "$@"
